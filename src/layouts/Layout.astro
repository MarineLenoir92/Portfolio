---
import '@fontsource/josefin-sans/400.css';
import '@fontsource/josefin-sans/700.css';
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/HomePage/Hero.astro';
import Presentation from '../components/HomePage/Presentation.astro';
import BentoGrid from '../components/HomePage/BentoGrid.astro';

interface Props {
	title: string;
	description?: string;
}

const { title = "Marine Lenoir", description = "Développeuse Front-end spécialisée A11y" } = Astro.props;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Marine Lenoir",
  "jobTitle": "Développeuse Web"
};
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} - {description}</title>
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} slot="head" />
	</head>
	<body>
		<a href="#main-content" class="sr-only-focusable">Aller au contenu</a>

		<header>
			<Navigation />
		</header>

		<main id="main-content">
			<Hero />
			<Presentation />
			<BentoGrid />
			<slot />
		</main>

		<footer>
			<Footer />
		</footer>
	</body>
</html>

<style is:global>
	.sr-only-focusable {
		position: absolute;
		width: 0.063rem;
		height: 0.063rem;
		padding: 0;
		margin: -0.063rem;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0 !important;
	}

	.sr-only-focusable:focus {
		position: static;
		display: block;
		text-align: center;
		background: var(--primary);
		color: var(--text-button);
		padding: 0.625rem 0;
		width: 100%;
		text-decoration: none;
		clip: auto;
		height: auto;
	}

	main {
		background-color: var(--bg-color);
	}

	footer {
		padding: 1.25rem 0.5rem;
	}

	@media (min-width: 64rem) {
		footer {
			height: 6.25rem;
			padding: 1.25rem 2.5rem;
		}
	}

</style>